<div class="xf-pop" id="xf-pop" role="dialog" aria-modal="false" hidden>
    <div class="xf-pop-head"><strong id="xf-title"><?= __('Filter') ?></strong></div>
    <input type="search" id="xf-q" class="xf-q" placeholder="<?= __('Cari di daftar...') ?>" autocomplete="off">
    <div class="xf-sort" role="group" aria-label="<?= __('Urutkan') ?>"><button type="button" class="xf-sort-btn" data-dir="asc" id="xf-sort-asc"><?= __('Urutkan naik') ?></button><button type="button" class="xf-sort-btn" data-dir="desc" id="xf-sort-desc"><?= __('Urutkan turun') ?></button></div>
    <div class="xf-list" id="xf-list" role="listbox" aria-multiselectable="true"><div class="xf-loading"><?= __('Memuat...') ?></div></div>
    <div class="xf-foot">
        <span class="spacer"></span>
        <button type="button" class="btn btn-outline btn-sm" id="xf-cancel"><?= __('Batal') ?></button>
        <button type="button" class="btn btn-brand btn-sm" id="xf-apply"><?= __('Terapkan') ?></button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
(function () {
  var f = document.getElementById('items-filter');
  var pop = document.getElementById('xf-pop');
  if (!f || !pop) return;
  var LABELS = <?= json_encode(['code'=>__('Kode'),'name'=>__('Nama'),'group'=>__('Group'),'location'=>__('Lokasi'),'device'=>__('Device'),'expected'=>__('Sistem'),'counted'=>__('Hitung'),'unit'=>__('Satuan'),'category'=>__('Kategori'),'price'=>__('Harga'),'count'=>__('Status Hitung'),'audit'=>__('Status Audit')], JSON_UNESCAPED_UNICODE) ?>;
  var NUMK = { expected:1, counted:1, price:1 };
  var sortKey = <?= json_encode($sortKey ?? null) ?>, sortDir = <?= json_encode($sortDir ?? null) ?>;
  var DISPLAY = <?= json_encode(['counted'=>__('Sudah dihitung'),'pending'=>__('Belum dihitung'),'posted'=>__('Terposting'),'audited'=>__('Sudah diaudit'),'discrepancy'=>__('Selisih'),'resolved'=>__('Selesai')], JSON_UNESCAPED_UNICODE) ?>;
  var current = null, picked = [], cache = {};
  var list = document.getElementById('xf-list'), q = document.getElementById('xf-q');
  var title = document.getElementById('xf-title');
  var base = <?= json_encode(url('items/distinct'), JSON_UNESCAPED_SLASHES) ?>;
  var sbase = <?= json_encode(url('items'), JSON_UNESCAPED_SLASHES) ?>;

  // Collect current col filters from hidden inputs (so picks survive re-open)
  function currentFilters(key) {
    var out = [];
    f.querySelectorAll('input.col-hidden').forEach(function (i) {
      var m = i.name.match(/^col\[([a-z]+)\]/);
      if (m && m[1] === key) out.push(i.value);
    });
    return out;
  }
  function filterQueryExcept(key) {
    var fd = new FormData(f), p = new URLSearchParams();
    fd.forEach(function (v, k) { if (!/^col\[/.test(k) || k.indexOf('col[' + key + ']') !== 0) p.append(k, v); });
    return p.toString();
  }
  function openPop(btn) {
    current = btn.getAttribute('data-xf');
    picked = currentFilters(current);
    title.textContent = 'Filter: ' + LABELS[current];
    markSortState();
    q.value = '';
    list.innerHTML = '<div class="xf-loading">' + <?= json_encode(__('Memuat...'), JSON_UNESCAPED_UNICODE) ?> + '</div>';
    var r = btn.getBoundingClientRect();
    pop.hidden = false;
    var left = Math.min(r.left + window.scrollX, window.scrollX + document.documentElement.clientWidth - 300);
    pop.style.left = Math.max(8, left) + 'px';
    pop.style.top = (r.bottom + window.scrollY + 6) + 'px';
    loadValues();
    q.focus();
  }
  function loadValues() {
    var qs = filterQueryExcept(current);
    var key = current;
    var url = base + '?key=' + encodeURIComponent(key) + (qs ? '&' + qs : '');
    fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
      if (key !== current) return;
      cache[key] = d.values || [];
      render();
    }).catch(function () { list.innerHTML = '<div class="xf-loading">' + <?= json_encode(__('Gagal memuat daftar.'), JSON_UNESCAPED_UNICODE) ?> + '</div>'; });
  }
  function render() {
    var term = q.value.trim().toLowerCase();
    var vals = cache[current] || [];
    if (vals.length === 0) { list.innerHTML = '<div class="xf-loading">' + <?= json_encode(__('Tidak ada nilai.'), JSON_UNESCAPED_UNICODE) ?> + '</div>'; return; }
    var html = '', shown = 0;
    vals.forEach(function (v) {
      if (term && v.toLowerCase().indexOf(term) === -1) return;
      shown++;
      var on = picked.indexOf(v) !== -1;
      var label = DISPLAY[v] || v;
      html += '<label class="xf-opt' + (on ? ' is-on' : '') + '"><input type="checkbox" value="' + escAttr(v) + '"' + (on ? ' checked' : '') + '><span>' + escHtml(label) + '</span></label>';
    });
    list.innerHTML = shown ? html : '<div class="xf-loading">' + <?= json_encode(__('Tidak ada yang cocok.'), JSON_UNESCAPED_UNICODE) ?> + '</div>';
  }
  function escHtml(s) { return String(s).replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function escAttr(s) { return escHtml(s); }
  list.addEventListener('change', function (e) {
    var v = e.target.value;
    if (e.target.checked) { if (picked.indexOf(v) === -1) picked.push(v); }
    else picked = picked.filter(function (x) { return x !== v; });
    e.target.closest('.xf-opt').classList.toggle('is-on', e.target.checked);
  });
  q.addEventListener('input', render);
  function close() { pop.hidden = true; current = null; }
  function apply() {
    // replace hidden col inputs for current key
    f.querySelectorAll('input.col-hidden').forEach(function (i) { if (i.name.indexOf('col[' + current + ']') === 0) i.remove(); });
    picked.forEach(function (v) {
      var h = document.createElement('input');
      h.type = 'hidden'; h.className = 'col-hidden'; h.name = 'col[' + current + '][]'; h.value = v;
      f.appendChild(h);
    });
    f.requestSubmit ? f.requestSubmit() : f.submit();
  }
  // ---- Sort dari menu filter (seperti Excel) ----
  function applySort(dir) {
    var old = f.querySelectorAll('input.sort-hidden');
    old.forEach(function (i) { i.remove(); });
    var k = document.createElement('input'); k.type = 'hidden'; k.className = 'sort-hidden'; k.name = 'sort'; k.value = current;
    var d = document.createElement('input'); d.type = 'hidden'; d.className = 'sort-hidden'; d.name = 'dir'; d.value = dir;
    f.appendChild(k); f.appendChild(d);
    f.requestSubmit ? f.requestSubmit() : f.submit();
  }
  document.getElementById('xf-sort-asc').addEventListener('click', function () { applySort('asc'); });
  document.getElementById('xf-sort-desc').addEventListener('click', function () { applySort('desc'); });
  function markSortState() {
    document.querySelectorAll('.xf-sort-btn').forEach(function (b) {
      var on = current && sortKey === current && sortDir && b.dataset.dir === (sortDir === 'DESC' ? 'desc' : 'asc');
      b.classList.toggle('is-on', !!on);
    });
  }
  document.querySelectorAll('.xf-btn').forEach(function (b) {
    b.addEventListener('click', function (e) {
      e.stopPropagation();
      if (!pop.hidden && current === b.getAttribute('data-xf')) { close(); return; }
      openPop(b);
    });
  });
  document.getElementById('xf-apply').addEventListener('click', apply);
  document.getElementById('xf-cancel').addEventListener('click', close);
  document.getElementById('xf-clear').addEventListener('click', function () { picked = []; render(); });
  document.addEventListener('click', function (e) { if (!pop.hidden && !pop.contains(e.target)) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

  // Quick search: debounce, no Enter needed
  var s = document.getElementById('search'), t = null;
  if (s) {
    s.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { f.requestSubmit ? f.requestSubmit() : f.submit(); }, 350); });
    s.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); clearTimeout(t); f.requestSubmit ? f.requestSubmit() : f.submit(); } });
  }

  // Advanced panel
  var adv = document.getElementById('adv-panel'), advBtn = document.getElementById('adv-toggle');
  var advRows = document.getElementById('adv-rows');
  var COLDEF = <?= json_encode([['code',__('Kode')],['name',__('Nama')],['category',__('Kategori')],['group',__('Group')],['group_code',__('Kode Group')],['location',__('Lokasi')],['location_code',__('Kode Lokasi')],['device',__('Device')],['device_type',__('Jenis Device')],['device_serial',__('Serial Device')],['unit',__('Satuan')],['price',__('Harga Satuan')],['expected',__('Sistem')],['counted',__('Hitung')],['count',__('Status Hitung')],['audit',__('Status Audit')],['amount_note',__('Catatan Jumlah')],['condition_note',__('Catatan Kondisi')]], JSON_UNESCAPED_UNICODE) ?>;
  var OPS = <?= json_encode([['in',__('salah satu dari')],['contains',__('mengandung')],['equals',__('sama dengan')],['starts',__('diawali')],['gt',__('lebih dari')],['lt',__('kurang dari')],['empty',__('kosong')]], JSON_UNESCAPED_UNICODE) ?>;
  var NUMERIC = { expected:1, counted:1, price:1 };
  var backdrop = document.getElementById('adv-backdrop');
  // Portal: pindahkan drawer+backdrop ke <body> agar position:fixed tidak terjebak di ancestor ber-transform.
  document.body.appendChild(backdrop); document.body.appendChild(adv);
  function openAdv() { adv.hidden = false; backdrop.hidden = false; advBtn.setAttribute('aria-expanded','true'); if (advRows.children.length === 0) addRow(); var first = advRows.querySelector('.adv-col'); if (first) first.focus(); }
  function closeAdv() { adv.hidden = true; backdrop.hidden = true; advBtn.setAttribute('aria-expanded','false'); advBtn.focus(); }
  var existing = <?= json_encode(array_values($filters['adv'])) ?>;
  function rowHtml(i, c) {
    c = c || {};
    var colOpts = COLDEF.map(function (d) { return '<option value="' + d[0] + '"' + (c.col === d[0] ? ' selected' : '') + '>' + d[1] + '</option>'; }).join('');
    var opOpts = OPS.map(function (o) { return '<option value="' + o[0] + '"' + (c.op === o[0] ? ' selected' : '') + '>' + o[1] + '</option>'; }).join('');
    return '<div class="adv-row" data-i="' + i + '">' +
      '<select class="adv-col" aria-label="Kolom">' + colOpts + '</select>' +
      '<select class="adv-op" aria-label="Kondisi">' + opOpts + '</select>' +
      '<input class="adv-val" type="text" placeholder="Nilai" value="' + escAttr(c.val || '') + '" aria-label="Nilai">' +
      '<button type="button" class="btn btn-outline btn-sm adv-pick" aria-label="Pilih nilai">Pilih nilai</button>' +
      '<button type="button" class="btn btn-ghost btn-sm adv-del" aria-label="Hapus kondisi">×</button></div>';
  }
  function addRow(c) { advRows.insertAdjacentHTML('beforeend', rowHtml(advRows.children.length, c)); }
  existing.forEach(function (c) { addRow(c); });
  advRows.querySelectorAll('.adv-row').forEach(function (r) { var isIn = r.querySelector('.adv-op').value === 'in'; r.querySelector('.adv-pick').hidden = !isIn; r.querySelector('.adv-val').hidden = isIn; refreshPickLabel(r); });
  // ---- Multi-nilai (op 'in'): pilih dari daftar nilai kolom + cari ----
  var pick = document.createElement('div');
  pick.className = 'adv-pick-pop'; pick.hidden = true;
  pick.innerHTML = '<input type="search" class="adv-pick-q" placeholder="Cari nilai..." aria-label="Cari nilai"><div class="adv-pick-list"></div><div class="adv-pick-foot"><button type="button" class="btn btn-ghost btn-sm adv-pick-clear">Kosongkan</button><button type="button" class="btn btn-brand btn-sm adv-pick-ok">Terapkan</button></div>';
  document.body.appendChild(pick);
  var pickRow = null, pickCache = {};
  function selectedOf(row) { var v = row.querySelector('.adv-val').value; return v ? v.split('\x1f') : []; }
  function refreshPickLabel(row) {
    var n = selectedOf(row).length; var b = row.querySelector('.adv-pick');
    if (b) b.textContent = n ? ('Pilih nilai (' + n + ')') : 'Pilih nilai';
  }
  function renderPick() {
    var list = pick.querySelector('.adv-pick-list'); var q = pick.querySelector('.adv-pick-q').value.toLowerCase();
    var sel = selectedOf(pickRow); var vals = pickCache[pickRow.querySelector('.adv-col').value] || [];
    list.innerHTML = vals.filter(function (v) { return !q || v.toLowerCase().indexOf(q) !== -1; }).map(function (v) {
      var on = sel.indexOf(v) !== -1;
      return '<label class="adv-pick-opt"><input type="checkbox" value="' + escAttr(v) + '"' + (on ? ' checked' : '') + '> <span>' + escAttr(v) + '</span></label>';
    }).join('') || '<div class="adv-pick-empty">' + <?= json_encode(__('Tidak ada yang cocok'), JSON_UNESCAPED_UNICODE) ?> + '</div>';
  }
  function openPick(row, btn) {
    pickRow = row; var col = row.querySelector('.adv-col').value;
    var r = btn.getBoundingClientRect(); var ph = 320; var top = r.bottom + 6; if (top + ph > window.innerHeight && r.top - ph - 6 > 0) top = r.top - ph - 6; pick.style.top = top + 'px'; pick.style.left = Math.max(8, Math.min(r.left, window.innerWidth - 308)) + 'px';
    pick.querySelector('.adv-pick-q').value = ''; pick.hidden = false;
    if (pickCache[col]) { renderPick(); pick.querySelector('.adv-pick-q').focus(); return; }
    pick.querySelector('.adv-pick-list').innerHTML = '<div class="adv-pick-empty">' + <?= json_encode(__('Memuat...'), JSON_UNESCAPED_UNICODE) ?> + '</div>';
    fetch(<?= json_encode(url('items/distinct'), JSON_UNESCAPED_SLASHES) ?> + '?key=' + encodeURIComponent(col), { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
      pickCache[col] = (j.values || []); renderPick(); pick.querySelector('.adv-pick-q').focus();
    }).catch(function () { pick.querySelector('.adv-pick-list').innerHTML = '<div class="adv-pick-empty">' + <?= json_encode(__('Gagal memuat nilai'), JSON_UNESCAPED_UNICODE) ?> + '</div>'; });
  }
  function closePick() { pick.hidden = true; pickRow = null; }
  pick.querySelector('.adv-pick-q').addEventListener('input', renderPick);
  pick.querySelector('.adv-pick-clear').addEventListener('click', function () { if (pickRow) { pickRow.querySelector('.adv-val').value = ''; refreshPickLabel(pickRow); renderPick(); } });
  pick.querySelector('.adv-pick-ok').addEventListener('click', function () { closePick(); });
  pick.querySelector('.adv-pick-list').addEventListener('change', function (e) {
    if (!pickRow || e.target.type !== 'checkbox') return;
    var vals = Array.prototype.map.call(pick.querySelectorAll('.adv-pick-list input:checked'), function (i) { return i.value; });
    pickRow.querySelector('.adv-val').value = vals.join('\x1f'); refreshPickLabel(pickRow);
  });
  advRows.addEventListener('click', function (e) {
    if (e.target.classList.contains('adv-pick')) { e.stopPropagation(); var row = e.target.closest('.adv-row'); if (pick.hidden || pickRow !== row) openPick(row, e.target); else closePick(); }
  });
  document.addEventListener('click', function (e) { if (!pick.hidden && !pick.contains(e.target) && !(e.target.classList && e.target.classList.contains('adv-pick'))) closePick(); });
  advRows.addEventListener('change', function (e) {
    if (e.target.classList.contains('adv-col')) { var row = e.target.closest('.adv-row'); row.querySelector('.adv-val').value = ''; refreshPickLabel(row); }
    if (e.target.classList.contains('adv-op')) { var r2 = e.target.closest('.adv-row'); var isIn = e.target.value === 'in'; r2.querySelector('.adv-pick').hidden = !isIn; r2.querySelector('.adv-val').hidden = isIn; if (!isIn) r2.querySelector('.adv-val').value = r2.querySelector('.adv-val').value.split('\x1f')[0]; refreshPickLabel(r2); }
  });
  advBtn.addEventListener('click', function () { if (adv.hidden) openAdv(); else closeAdv(); });
  document.querySelector('button[form="items-filter"]') && document.querySelector('button[form="items-filter"]').addEventListener('click', function () { closeAdv(); closePick(); });
  backdrop.addEventListener('click', closeAdv);
  adv.querySelector('.adv-close').addEventListener('click', closeAdv);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !adv.hidden) closeAdv(); });
  document.getElementById('adv-add').addEventListener('click', function () {
    if (advRows.children.length >= 12) return;
    addRow();
  });
  advRows.addEventListener('click', function (e) {
    if (e.target.classList.contains('adv-del')) e.target.closest('.adv-row').remove();
  });
  // Serialize advanced rows into hidden inputs right before submit
  f.addEventListener('submit', function () {
    f.querySelectorAll('input[name^="adv["]').forEach(function (i) { i.remove(); });
    var n = 0;
    advRows.querySelectorAll('.adv-row').forEach(function (r) {
      var col = r.querySelector('.adv-col').value, op = r.querySelector('.adv-op').value, val = r.querySelector('.adv-val').value.trim();
      if (op !== 'empty' && val === '') return;
      [['col', col], ['op', op], ['val', val]].forEach(function (kv) {
        var h = document.createElement('input'); h.type = 'hidden'; h.name = 'adv[' + n + '][' + kv[0] + ']'; h.value = kv[1]; f.appendChild(h);
      });
      n++;
    });
  });
})();
});
</script>

    <?= View::partial('partials/pagination', ['paginator' => $items, 'query' => $cleanQuery]) ?>
</div>

<!-- Bottom Action Bar (Mobile/Tablet) -->
<div class="bottom-action-bar">
    <button type="button" class="btn btn-primary" data-scan-open style="flex: 1;">
        <?= icon('scan') ?> Scan Barcode
    </button>
    <button type="button" class="btn btn-outline" onclick="document.querySelector('#search').focus()" style="flex: 0 0 auto;">
        <?= icon('search') ?> Cari
    </button>
</div>


<!-- Modal scanner barcode -->
<div class="modal-backdrop" data-scan-modal role="dialog" aria-modal="true" aria-label="<?= __('Scan barcode') ?>">
    <div class="modal">
        <div class="modal-header">
            <h3><?= icon('scan') ?> Scan Barcode / QR</h3>
            <div class="spacer"></div>
            <button type="button" class="icon-btn" data-scan-close aria-label="<?= __('Tutup') ?>"><?= icon('x') ?></button>
        </div>
        <div class="modal-body">
            <div id="scanner-viewport"></div>
            <p class="scanner-hint">Arahkan kamera ke barcode atau QR code. Hasil scan otomatis mengisi pencarian lalu memfilter tabel.</p>
        </div>
    </div>
</div>

<script src="<?= asset_v('js/table-colmgr.js') ?>" defer></script>
<script>
(function () {
    var MEMO_URL = '/items/memo/preview';
    var PDF_URL = '/items/memo.pdf';
    var all = document.getElementById('memo-all');
    var cnt = document.getElementById('memo-count');
    function boxes() { return Array.prototype.slice.call(document.querySelectorAll('.memo-check')); }
    function visible(cb) { var r = cb.closest('tr'); return r && r.style.display !== 'none' && !r.hidden; }
    function picked() { return boxes().filter(function (c) { return c.checked; }).map(function (c) { return c.value; }); }
    function refresh() {
        var ids = picked();
        cnt.textContent = ids.length + ' item dipilih';
        if (all) {
            var vis = boxes().filter(visible);
            all.checked = vis.length > 0 && vis.every(function (c) { return c.checked; });
        }
    }
    if (all) all.addEventListener('change', function () {
        boxes().filter(visible).forEach(function (c) { c.checked = all.checked; });
        refresh();
    });
    document.addEventListener('change', function (e) {
        if (e.target.classList && e.target.classList.contains('memo-check')) refresh();
    });
    refresh();
})();
</script>
