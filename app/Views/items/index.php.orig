    $__baseQ = $_GET;
    unset($__baseQ['count_status'], $__baseQ['page']);
    $__tabUrl = static function (array $cs) use ($__baseQ): string {
        $q = $__baseQ;
        if ($cs !== []) { $q['count_status'] = $cs; }
        return url('items') . ($q !== [] ? '?' . http_build_query($q) : '');
    };
    $__tabs = [
        ['all',     __('status.all'),           [],                              (int) $tabCounts['total']],
        ['counted', __('status.counted'),  ['counted', 'posted'],           (int) $tabCounts['counted']],
